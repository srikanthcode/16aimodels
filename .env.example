# ---------------------------------------------------------------------------
# Public API authentication
# ---------------------------------------------------------------------------
# Clients must send: Authorization: Bearer <APP_API_KEY>
# Use a long random value, for example: openssl rand -hex 32
# Minimum length: 16 characters.
APP_API_KEY=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# Inference backend (Ollama behind a private tunnel)
# ---------------------------------------------------------------------------
# Base URL of the secure tunnel or reverse proxy in front of Ollama.
# Must be reachable from Render. Use HTTPS in production.
# Do not include credentials, a query string, or a fragment.
# A base path is allowed, e.g. https://tunnel.example.com/ollama
HYPERNET_OLLAMA_URL=https://your-private-tunnel.example.com

# Optional bearer token expected by the tunnel or Ollama reverse proxy.
# Leave empty when the tunnel itself provides authentication.
HYPERNET_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Render supplies PORT automatically. The default is 10000.
PORT=10000

# Maximum time to wait for the backend, in milliseconds (1000-900000).
UPSTREAM_TIMEOUT_MS=285000

# After UPSTREAM_TIMEOUT_MS, the client gets a 504 but the backend request is
# kept open in the background up to this many milliseconds so the prompt cache
# gets seeded (retry then returns in seconds). Must exceed UPSTREAM_TIMEOUT_MS.
# Set <= UPSTREAM_TIMEOUT_MS to disable.
UPSTREAM_WARMUP_TIMEOUT_MS=5400000

# Maximum accepted request body size, in bytes (default 10 MiB).
MAX_BODY_BYTES=10485760

# Maximum number of strings accepted by /v1/embeddings per request.
MAX_EMBED_INPUTS=256

# Ollama context window override. 0 keeps the backend default.
OLLAMA_NUM_CTX=0

# Optional Ollama keep_alive value, e.g. 5m or 30m. Empty uses the backend default.
OLLAMA_KEEP_ALIVE=

# CORS: "*" or a comma-separated list of allowed origins.
CORS_ORIGIN=*
